    {
      "id": "issue_repro",
      "description": "Issue #3621 repro: URL query must survive a params= merge",
      "expected": "https://safebooru.org/index.php?page=post&s=list&pid=0&tags=k-on%21",
      "results": {
        "pr3759": {
          "value": "https://safebooru.org/index.php?page=post&s=list&pid=0&tags=k-on%21",
          "ok": true
        },
        "pr3761": {
          "value": "https://safebooru.org/index.php?page=post&s=list&pid=0&tags=k-on%21",
          "ok": true
        },
        "shipped": {
          "value": "https://safebooru.org/index.php?page=post&s=list&pid=0&tags=k-on%21",
          "ok": true
        },
        "upstream": {
          "value": "https://safebooru.org/index.php?pid=0&tags=k-on%21",
          "ok": false
        }
      }
    },
    {
